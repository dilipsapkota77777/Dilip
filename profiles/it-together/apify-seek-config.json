{
  "_note": "IT Together — SEEK Signal Scraper Config",
  "_actor": "Use actor: misceres/seek-scraper OR apify/seek-jobs-scraper on apify.com",
  "_instructions": [
    "1. Go to apify.com -> Sign up (free)",
    "2. Search 'SEEK Jobs Scraper' in the Actor Store",
    "3. Paste one search config below into the Input tab",
    "4. Click Run -> wait 2-5 min -> Export as CSV",
    "5. Repeat for each search query",
    "6. Merge all CSVs into one sheet before importing to Clay"
  ],

