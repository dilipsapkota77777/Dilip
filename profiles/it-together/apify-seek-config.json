  "clean_rules": {
    "remove_if_company_contains": [
      "recruit", "staffing", "labour hire", "hays", "hudson", "robert half",
      "manpower", "randstad", "people2people", "michael page", "adecco",
      "kelly services", "talent", "Confidential"
    ],
    "remove_if_company_is_IT": [
      "managed it", "managed services", "msp", "it solutions", "it services",
      "cybersecurity solutions", "tech solutions", "technology solutions",
      "cloud services", "it consulting", "digital solutions"
    ],
    "keep_headcount": "10-250",
    "keep_work_type": "Full time only"
  },

  "clay_columns_to_add_after_import": [
    "signal_source = SEEK_IT_HIRE",
    "signal_date = [date of scrape]",
    "signal_tier = Tier 1",
    "job_title_signal = [the role they posted]",
    "campaign_route = [from config above]"
  ],

  "expected_output": {
    "raw_listings_per_run": "50-200 per search query",
    "total_after_8_searches": "200-800 raw listings",
    "after_cleaning_recruiter_IT": "100-400 unique companies",
    "after_headcount_filter_10_to_250": "60-250 qualifying companies",
    "email_find_rate_75pct": "45-188 sendable contacts",
    "expected_meetings_5_to_8_per_100": "3-10 meetings from first run"
  }
