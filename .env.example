# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — only needed for the skills you'll use
# Hunter.io for prospect email finding
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo.io for prospect enrichment
APOLLO_API_KEY=your_apollo_api_key_here

# LinkedIn via RapidAPI for prospect research
RAPIDAPI_KEY=your_rapidapi_key_here

# SendGrid for sending emails
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Mailgun for sending emails (alternative to SendGrid)
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here

# Clearbit for company/contact enrichment
CLEARBIT_API_KEY=your_clearbit_api_key_here
